<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<DebugType>embedded</DebugType>

		<VersionPrefix>3.3.0</VersionPrefix>
		<Description>all play and no cheats makes among us a dull game</Description>
		<Authors>scp222thj, astra1dev</Authors>

		<GameDirectory>E:\SteamLibrary\steamapps\common\Among Us</GameDirectory>
		<BepInEx>E:\SteamLibrary\steamapps\common\Among Us\BepInEx</BepInEx>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" Private="false" ExcludeAssets="runtime;native" />
		<PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.8.18" PrivateAssets="all" />

		<PackageReference Include="BepInEx.AutoPlugin" Version="1.1.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.1" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="$(BepInEx)\interop\*.dll" Private="false" />
	</ItemGroup>

	<Target Name="Copy" AfterTargets="Build" Condition="'$(GameDirectory)' != ''">
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDirectory)/BepInEx/plugins/" UseSymboliclinksIfPossible="true" />
	</Target>
</Project>